# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# git-ignored (matches the *.local rule) — never commit real keys.
#
# The anon key is meant to be public — it ships in the browser bundle by
# design. Supabase's Row Level Security policies (see supabase/schema.sql)
# are what actually keep enquiry data private, not this key being secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
